{
  "name": "@clawde/orca-core",
  "version": "1.0.0",
  "description": "Orca pod runtime — orchestrates Maestro, Miranda, Pappy via port interfaces; no Benson dependency",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
