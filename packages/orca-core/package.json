    "maestro-core": "workspace:*",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.12.0",
    "@types/sql.js": "^1.4.9",
    "typescript": "^5.7.3",
    "vitest": "^4.0.0"
  },
  "license": "MIT"
