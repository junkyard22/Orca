{
  "name": "@clawde/orca-core",
  "version": "0.1.0",
  "description": "Orca pod runtime — orchestrates Maestro, Miranda, Pappy via port interfaces; no Benson dependency",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@clawde/miranda-core": "workspace:*",
    "@clawde/pappy-core": "workspace:*",
    "maestro-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.12.0",
    "vitest": "^2.1.8"
  },
  "license": "MIT"
}
