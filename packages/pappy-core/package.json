{
  "name": "@clawde/pappy-core",
  "version": "1.0.0",
  "description": "Internal QC evaluator for Orca pod — deterministic, silent, never user-facing",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "trace": "node dist/pappy-trace.js",
    "trace:build": "tsc && node dist/pappy-trace.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@clawde/miranda-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.12.0",
    "vitest": "^4.0.0"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
