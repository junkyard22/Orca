{
  "name": "@clawde/ext-web",
  "version": "0.1.0",
  "description": "Orca extension — web tools (fetch URL content, search DuckDuckGo)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
