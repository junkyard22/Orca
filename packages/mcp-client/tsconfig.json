{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "composite": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  // Tests are excluded from the build, matching the other packages.  Without
  // this, tsc emits dist/index.test.js and vitest then discovers both the source
  // and compiled copies, running every test twice.
  "exclude": ["src/**/*.test.ts", "dist", "node_modules"],
  "references": [
    { "path": "../../packages/orca-core" }
  ]
}
