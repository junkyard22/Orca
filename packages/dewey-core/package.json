{
  "name": "@clawde/dewey-core",
  "version": "1.0.0",
  "description": "Dewey — user context manager and pre-flight plan reviewer for Orca",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/context/userContext.json','dist/context/userContext.json')\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "typescript": "^5.7.3",
    "vitest": "^4.0.0"
  },
  "license": "MIT"
}
