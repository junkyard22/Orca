{
  "name": "orca",
  "version": "1.0.0",
  "description": "Orca — multi-core AI runtime monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "contract:check": "tsx scripts/contract-check.ts",
    "contract:check:strict": "tsx scripts/contract-check.ts --strict",
    "pappy:eval": "pnpm --filter @clawde/pappy-eval run eval",
    "pappy:eval:raw-real-pappy": "pnpm --filter @clawde/pappy-eval run eval:raw-real-pappy",
    "pappy:eval:pappy-plus-hardening": "pnpm --filter @clawde/pappy-eval run eval:pappy-plus-hardening",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.30.2",
  "license": "PolyForm-Noncommercial-1.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ],
    "overrides": {
      "esbuild": ">=0.28.1",
      "vite": ">=8.1.0",
      "form-data": ">=4.0.6",
      "picomatch@4": "4.0.4",
      "brace-expansion@1": ">=1.1.18 <2.0.0",
      "brace-expansion@2": ">=2.1.4 <3.0.0",
      "brace-expansion@5": ">=5.0.9",
      "lodash": ">=4.18.1",
      "@xmldom/xmldom": ">=0.9.10",
      "hono": ">=4.12.34",
      "@hono/node-server": ">=2.0.5 <3.0.0",
      "postcss": ">=8.5.18",
      "nanoid@<3.3.18": "3.3.18",
      "ip-address": ">=10.3.1",
      "js-yaml": ">=4.3.1 <5.0.0",
      "fast-uri": ">=3.1.5 <4.0.0",
      "qs": ">=6.15.2",
      "tmp": ">=0.2.7",
      "tar": ">=7.5.18",
      "body-parser": ">=2.3.0"
    }
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "node-gyp": "^12.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
