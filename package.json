{
  "name": "orca",
  "version": "0.1.0",
  "description": "Orca — multi-core AI runtime monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ],
    "overrides": {
      "esbuild": ">=0.25.0",
      "vite": ">=6.2.0"
    }
  },
  "devDependencies": {
    "node-gyp": "^12.2.0",
    "typescript": "^5.9.3"
  }
}
