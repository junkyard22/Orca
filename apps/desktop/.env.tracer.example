# .env.tracer — plaintext API keys for orca-tracer CLI runs
#
# The Orca desktop app encrypts keys with Electron's safeStorage, which
# cannot be decrypted outside the Electron process. Copy this file to
# .env.tracer and fill in your raw keys so the tracer can call the APIs.
#
# .env.tracer is gitignored — never commit real keys.
#
# Only set keys for providers you have configured in the Settings UI.

# Alibaba / DashScope (used by brain, strong_model, cheap_model, reviewer)
DASHSCOPE_API_KEY=

# OpenRouter (used by utility, narrator)
OPENROUTER_API_KEY=

# Other providers (fill in if you add them in Settings)
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# SILICONFLOW_API_KEY=
# ZAI_API_KEY=
