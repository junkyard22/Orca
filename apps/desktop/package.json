{
  "name": "@clawde/desktop",
  "version": "1.2.0",
  "description": "Orca — AI coding assistant desktop app",
  "author": "Clawde",
  "private": true,
  "main": "dist-main/main.js",
  "scripts": {
    "dev": "node build-main.mjs && node run-dev.mjs",
    "build": "node build-main.mjs",
    "dist": "node build-dist.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clawde/benson-core": "workspace:*",
    "@clawde/dewey-core": "workspace:*",
    "@clawde/ext-docs": "workspace:*",
    "@clawde/ext-github": "workspace:*",
    "@clawde/ext-web": "workspace:*",
    "@clawde/miranda-core": "workspace:*",
    "@clawde/orca-core": "workspace:*",
    "@clawde/tool-bootstrap": "workspace:*",
    "@yakstacks/workbench-core": "workspace:*",
    "dotenv": "^16.4.0",
    "maestro-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^39.8.5",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^4.0.0"
  },
  "build": {
    "appId": "com.clawde.orca",
    "productName": "Orca",
    "copyright": "Copyright © 2026",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "orca.ico",
        "to": "orca.ico"
      },
      {
        "from": "../../orca-settings.example.json",
        "to": "orca-settings.example.json"
      }
    ],
    "files": [
      "dist-main/**",
      "renderer/**",
      "!**/*.map"
    ],
    "win": {
      "icon": "orca.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "orca.ico",
      "uninstallerIcon": "orca.ico"
    }
  }
}
