# ── Required ────────────────────────────────────────────────────────────────
# OpenRouter API key — get one free at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# ── Optional ─────────────────────────────────────────────────────────────────
# Forwarded as HTTP-Referer and X-Title headers to OpenRouter.
# Helps OpenRouter show your app in dashboard analytics.
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=orca-runner
