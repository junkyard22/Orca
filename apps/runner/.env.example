# ── Provider selection ───────────────────────────────────────────────────────
# Set LLM_PROVIDER to choose where calls are routed:
#   openrouter  (default) — use OPENROUTER_API_KEY below
#   alibaba               — use ALIBABA_CLOUD_API_KEY below (Qwen via DashScope)
#   ollama                — use OLLAMA_BASE_URL / OLLAMA_MODEL below (local)
# LLM_PROVIDER=openrouter

# ── OpenRouter ───────────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=openrouter (or unset).
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# Forwarded as HTTP-Referer and X-Title headers to OpenRouter.
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=orca-runner

# ── Alibaba Cloud / DashScope (Qwen models) ──────────────────────────────────
# Required when LLM_PROVIDER=alibaba.
# Get your key at https://dashscope.console.aliyun.com/apiKey
# ALIBABA_CLOUD_API_KEY=sk-YOUR_DASHSCOPE_KEY_HERE
# LLM_MODEL=qwen-max
# Set to true only if you want Qwen3 chain-of-thought reasoning enabled.
# ALIBABA_ENABLE_THINKING=false

# ── Ollama (local) ───────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=ollama.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
