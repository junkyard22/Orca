{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "composite": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"],
  "references": [
    { "path": "../../packages/miranda-core" },
    { "path": "../../packages/dewey-core" },
    { "path": "../../packages/maestro-core" },
    { "path": "../../packages/pappy-core" },
    { "path": "../../packages/benson-core" },
    { "path": "../../packages/orca-core" },
    { "path": "../../packages/agent-loop-core" },
    { "path": "../../packages/workbench-core" },
    { "path": "../../packages/ext-github" },
    { "path": "../../packages/ext-docs" },
    { "path": "../../packages/ext-web" },
    { "path": "../../packages/mcp-client" },
    { "path": "../../packages/tool-bootstrap" }
  ]
}
