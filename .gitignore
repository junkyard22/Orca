# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
dist-main/
dist-exe/
build/
*.tsbuildinfo

# Compiled executables
orca.exe

# Electron-builder output
release/

# Environment files (never commit real keys)
.env
.env.local
.env.*.local
.env.tracer

# User config files — contain real API keys; use *.example.json as templates
orca-settings.json
apps/desktop/alibaba-config.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
miranda-runs.jsonl
.pytest_cache/

# Backup / scratch files
*.backup
*.bak
apps/runner/fun_facts.txt
apps/runner/random_fun_fact.txt
.tmp-home*/
tmp-run/

# release-smoke output (outputDir in release-smoke.json).  The config itself is
# committed on purpose; only the generated reports are ignored.
smoke-reports/

# ORCA_PROFILE=1 run output.  makeProfilePath() names these
# `run-<ISO-timestamp>.jsonl`, so match the timestamp shape rather than the whole
# directory: profile-runs/run-1..3 are curated evidence cited by
# PROFILING_FINDINGS.md and must stay tracked, and a future curated profile
# should be committable under a simple name without needing `git add -f`.
profile-runs/run-[0-9][0-9][0-9][0-9]-*.jsonl

# Editor
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

.claude/settings.local.json
